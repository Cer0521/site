# Session Pooler (Port 5432):
DIRECT_URL=postgresql://postgres.qzvuvzwehfjdsqldnjwq:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

FLASK_SECRET=replace-with-a-random-secret-key
FLASK_ENV=production
